FROM isaudits/kali:msf

ENV DEBIAN_FRONTEND=noninteractive

ARG S6_OVERLAY_VERSION=3.2.3.2

SHELL ["/bin/bash", "-c"]
USER root
ENV HOME=/root

# Desktop and RDP access (NOTE - xorgxrdp removed from Kali repo so have to backdoor from unstable)
RUN apt update && \
    apt install -y --no-install-recommends xrdp dbus-x11 xauth xvfb kali-desktop-xfce xfce4-goodies zenmap legion xz-utils && \
    echo 'deb http://deb.debian.org/debian unstable main' > /etc/apt/sources.list.d/debian-unstable.list && \
    cd /tmp && \
    apt-get update && \
    apt-get download xorgxrdp=1:0.10.5-2 && \
    rm -f /etc/apt/sources.list.d/debian-unstable.list && \
    apt install -y /tmp/xorgxrdp_1%3a0.10.5-2_$(dpkg --print-architecture).deb && \
    rm -f /tmp/xorgxrdp_1%3a0.10.5-2_$(dpkg --print-architecture).deb && \
    apt autoremove -y && \
    apt clean && \
    rm -rf /var/lib/apt/lists/*

# SECFORCE Sparta
RUN apt update && \
    apt install -y --no-install-recommends python3-sqlalchemy python3-pyqt5 ldap-utils x11-apps finger hydra && \
    git clone --recursive https://github.com/SECFORCE/sparta /opt/sparta && \
    rm -rf /opt/sparta/.git && \
    echo 'cd /opt/sparta && python3 sparta.py' > /usr/local/sbin/sparta && \
    chmod 755 /usr/local/sbin/sparta && \
    apt autoremove -y && \
    apt clean && \
    rm -rf /var/lib/apt/lists/*

# Set up pyenv to run sparta under - SQLAlchemy no longer works with old version of Sparta; have to symlink in pyqt5
# since it will not build inside of pyenv
RUN curl https://pyenv.run | bash && \
    echo 'export PYENV_ROOT="$HOME/.pyenv"' >> /root/.zshrc && \
    echo '[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"' >> /root/.zshrc && \
    echo 'eval "$(pyenv init - bash)"' >> /root/.zshrc && \
    echo 'eval "$(pyenv virtualenv-init -)"' >> /root/.zshrc && \
    echo 'export PYENV_ROOT="$HOME/.pyenv"' >> /root/.bashrc && \
    echo '[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"' >> /root/.bashrc && \
    echo 'eval "$(pyenv init - bash)"' >> /root/.bashrc && \
    echo 'eval "$(pyenv virtualenv-init -)"' >> /root/.bashrc && \
    echo 'export PYENV_ROOT="$HOME/.pyenv"' >> /root/.profile && \
    echo '[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"' >> /root/.profile && \
    echo 'eval "$(pyenv init - bash)"' >> /root/.profile && \
    echo 'eval "$(pyenv virtualenv-init -)"' >> /root/.profile && \
    export PYENV_ROOT="$HOME/.pyenv" && \
    export PATH="$PYENV_ROOT/bin:$PATH" && \
    eval "$(pyenv init - bash)" && \
    eval "$(pyenv virtualenv-init -)" && \
    pyenv virtualenv system sparta && \
    pyenv activate sparta && \
    pip install --upgrade pip && \
    pip install sqlalchemy==1.4.54 requests && \
    ln -s /usr/lib/python3/dist-packages/PyQt5 "$(python -c 'import sysconfig; print(sysconfig.get_path("purelib"))')/" && \
    echo 'cd /opt/sparta && eval "$(pyenv init -)" && pyenv activate sparta && python3 sparta.py' > /usr/local/sbin/sparta && \
    mkdir -p ~/.local/bin && \
    echo 'cd /opt/sparta && eval "$(pyenv init -)" && pyenv activate sparta && python3 sparta.py' > ~/.local/bin/sparta && \
    chmod 755 ~/.local/bin/sparta

# Add S6 overlay
ARG TARGETARCH
RUN [ "${TARGETARCH}" = "arm64" ] && S6_ARCH="aarch64" || S6_ARCH="x86_64"; \
    cd /tmp && \
    for f in noarch ${S6_ARCH} symlinks-noarch symlinks-arch; do \
        wget -q https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-${f}.tar.xz{,.sha256} && \
        sha256sum -c s6-overlay-${f}.tar.xz.sha256 && \
        tar -C / -Jxpf s6-overlay-${f}.tar.xz || exit 1; \
    done && \
    rm -f /tmp/s6-overlay-*

# add local files
COPY root/ /

ENTRYPOINT ["/init"]